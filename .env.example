# 複製成 .env 後填值。.env 已被 .gitignore 忽略，不會進版控。

# --- 目前已接線（讀 repo 根 .env）---

# HackMD 自動上傳（humanizer-zh 跑完會用）。
# 去 HackMD → Settings → API & Webhooks 產生 token。
# 找不到這裡時會回退讀 ~/.claude/.env，維持舊機器相容。
HACKMD_API_TOKEN=

# --- 以下為打包 spec 規劃中的鍵，yt 主流程尚未改讀 repo .env ---
# （目前 yt_to_article.py 仍讀舊路徑；接線屬 spec §4.3 後續工作）

# MiniMax（Anthropic 相容端點）
ANTHROPIC_API_KEY=sk-cp-xxxx
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M3

# 文章落檔位置（每台機器不同，填你的 Obsidian 路徑；留空則落到 <repo>/output/）
YT_OUTPUT_DIR=

# Whisper 後端：auto | cuda | mlx | cpu
WHISPER_DEVICE=auto
